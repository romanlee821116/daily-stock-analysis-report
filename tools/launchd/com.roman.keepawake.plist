<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>              <string>com.roman.keepawake</string>
  <key>WorkingDirectory</key>   <string>/Users/roman/project/daily-stock-analysis-report</string>
  <key>ProgramArguments</key>
  <array><string>/bin/bash</string><string>tools/keepawake.sh</string></array>
  <!-- 週一到週五 05:46（pmset 05:40 喚醒之後），保持清醒到 09:30 -->
  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Weekday</key><integer>1</integer><key>Hour</key><integer>5</integer><key>Minute</key><integer>46</integer></dict>
    <dict><key>Weekday</key><integer>2</integer><key>Hour</key><integer>5</integer><key>Minute</key><integer>46</integer></dict>
    <dict><key>Weekday</key><integer>3</integer><key>Hour</key><integer>5</integer><key>Minute</key><integer>46</integer></dict>
    <dict><key>Weekday</key><integer>4</integer><key>Hour</key><integer>5</integer><key>Minute</key><integer>46</integer></dict>
    <dict><key>Weekday</key><integer>5</integer><key>Hour</key><integer>5</integer><key>Minute</key><integer>46</integer></dict>
  </array>
  <key>StandardOutPath</key>    <string>/Users/roman/project/daily-stock-analysis-report/data/awake.log</string>
  <key>StandardErrorPath</key>  <string>/Users/roman/project/daily-stock-analysis-report/data/awake.log</string>
  <key>RunAtLoad</key>          <false/>
</dict>
</plist>
